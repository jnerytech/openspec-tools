{
  "name": "openspec-tools",
  "version": "0.1.0",
  "description": "OpenSpec extension: web reader for changes + review skill pack",
  "type": "module",
  "bin": {
    "opsx-tools": "./dist/main.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "compile": "npm run build",
    "typecheck": "node -e \"require('fs').rmSync('.tscheck',{recursive:true,force:true})\" && tsc -p tsconfig.check.json",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "npm run typecheck && npm run test:compiled",
    "test:compiled": "node --enable-source-maps --experimental-test-module-mocks --test \".tscheck/**/*.test.js\"",
    "coverage": "npm run typecheck && node --enable-source-maps --experimental-test-module-mocks --test --experimental-test-coverage \".tscheck/**/*.test.js\"",
    "gate": "tsx src/gate/run.ts",
    "prepare": "npm run build && (git config core.hooksPath .githooks || true)"
  },
  "keywords": [
    "openspec",
    "sdd",
    "spec-driven",
    "ai",
    "reader"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "commander": "^14.0.0",
    "marked": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
